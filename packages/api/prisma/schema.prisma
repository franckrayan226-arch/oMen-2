generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// MULTI-TENANT : 2 boutiques sur 1 backend
// ============================================================

model Store {
  id          String   @id @default(cuid())
  name        String   // "omen-shoes" | "omen-wellness"
  displayName String   // "oMen Shoes" | "oMen Wellness"
  domain      String   @unique // "omenshoes.com" | "omenwellness.com"
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  orders     Order[]
  customers  Customer[]
  categories Category[]
  partners   Partner[]
  notifications Notification[]

  // Partenariats influenceurs (config globale par boutique)
  partnerDiscountPct   Int @default(10) // % offert au client via le code influenceur
  partnerCommissionPct Int @default(5)  // % de commission versé à l'influenceur
}

// ============================================================
// CATEGORIES (source de vérité — gérées depuis le dashboard)
// ============================================================

model Category {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  image     String   @default("")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId, active])
}

// ============================================================
// PRODUITS
// ============================================================

model Product {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  slug        String   @unique
  description String?
  price       Int      // Prix de base en FCFA
  compareAt   Int?     // Prix barré
  category    String
  brand       String   @default("") // Marque: iPhone, Samsung, JBL...
  tags        String   @default("") // Stocké comme "tag1,tag2,tag3"
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  colors     ProductColor[]
  images     ProductImage[]
  variants   ProductVariant[]

  @@index([storeId, category])
  @@index([storeId, active])
}

model ProductColor {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // "Noir", "Blanc", "Chicago", etc.
  hex       String   // Code couleur hex #RRGGBB
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   ProductImage[]
  variants ProductVariant[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String?
  color     ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String?
  color     ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  size      String   // "38", "39", "40", "S", "M", "L", etc.
  sku       String?  // Référence interne optionnelle
  price     Int?     // Prix spécifique à ce variant (null = prix produit)
  compareAt Int?     // Prix barré spécifique
  stock     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, colorId, size])
  @@index([productId, active])
  @@index([productId, colorId])
}

// ============================================================
// CLIENTS
// ============================================================

model Customer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  email     String
  phone     String?
  name      String?
  address   String?  // JSON string: { street, city, country, zip }
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, email])
}

// ============================================================
// COMMANDES
// ============================================================

model Order {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  reference       String?  @unique // Référence GeniusPay (MTX-...)
  status          String   @default("PENDING") // PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  subtotal        Int
  shipping        Int      @default(0)
  total           Int
  currency        String   @default("XOF")
  paymentMethod   String?  // "wave", "orange_money", "mtn", "card"
  paymentRef      String?  // GeniusPay reference
  shippingAddress String?  // JSON string snapshot de l'adresse
  notes           String?
  couponCode      String?   // Code influenceur utilisé (ex: KM4X9B)
  partnerId       String?
  partner         Partner?  @relation(fields: [partnerId], references: [id])
  discount        Int      @default(0) // Réduction accordée via le code (FCFA)
  commission      Int      @default(0) // Commission due à l'influenceur (FCFA)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items OrderItem[]

  @@index([storeId, status])
  @@index([reference])
  @@index([partnerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  name      String  // Snapshot du nom
  price     Int     // Snapshot du prix
  quantity  Int
}

// ============================================================
// ADMIN USERS (Dashboard)
// ============================================================

model AdminUser {
  id        String   @id @default(cuid())
  username  String?  @unique // Nom d'utilisateur pour la connexion
  email     String   @unique
  password  String   // bcrypt hash
  name      String
  role      String   @default("ADMIN") // SUPER_ADMIN | ADMIN | EDITOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PAIEMENTS GeniusPay
// ============================================================

model PaymentLog {
  id         String   @id @default(cuid())
  orderId    String
  reference  String   // GeniusPay reference (MTX-...)
  event      String   // "payment.created", "payment.success", "payment.failed"
  payload    String   // JSON string webhook payload
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([reference])
}

// ============================================================
// PARTENAIRES INFLUENCEURS (codes promo uniques)
// ============================================================

model Partner {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  name      String
  phone     String?
  handle    String?  // @instagram / tiktok
  code      String   @unique // Code promo unique généré
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  notifications Notification[]

  @@index([storeId, active])
}

// ============================================================
// NOTIFICATIONS DASHBOARD
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  type      String   // "partner_sale"
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, read])
}

